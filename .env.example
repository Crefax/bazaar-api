# Bazaar API runtime configuration
# Copy this file to .env for local development and replace placeholder secrets.

# Server
BIND_ADDR=127.0.0.1:22417

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=skyblock

# Admin authentication
# Required for /admin and /api/v2/admin/*.
# Use a long random value in production.
ADMIN_API_KEY=change-this-admin-key

# CORS
# Comma-separated origins. Leave empty for local/dev allow-any-origin behavior.
CORS_ALLOWED_ORIGINS=

# Proxy/IP handling
# Set true only when the service is behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Optional Redis
# The current build reads this value and reports it in /ready; in-process cache/rate-limit fallback is used when Redis is not wired.
REDIS_URL=
